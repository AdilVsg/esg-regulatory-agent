# LLM provider (pick one and update src/agent accordingly)
GEMINI_API_KEY=

# Web search tool used by the agent's out-of-corpus branch
TAVILY_API_KEY=

# Vector store persistence path (local dev)
CHROMA_PERSIST_DIR=./data/processed/chroma

# Used only when running against the deployed Cloud Run service
API_BASE_URL=http://localhost:8080
